PORT=4000

# MySQL connection string (adjust user/pass/host/db)
# Note: Special characters in password must be URL-encoded (e.g., @ = %40)
DATABASE_URL="mysql://root:password@localhost:3306/homebiz"

# JWT Configuration
JWT_SECRET="your-super-secret-key-min-32-characters-long"
JWT_EXPIRES_IN="7d"

# Logging Configuration
LOG_LEVEL="info"
# Available levels: error, warn, info, debug

# SMTP Configuration (Email notifications)
SMTP_ENABLED="true"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@homebiz.local"

# WhatsApp Configuration (mock/scaffold for MVP)
# Integration options: whatsapp-web.js (browser automation), Twilio, 360dialog
# QR code linked account flow via GET /webhooks/whatsapp/qr
WHATSAPP_ENABLED="true"
