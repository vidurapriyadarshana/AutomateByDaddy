PORT=4000

# MySQL connection string (adjust user/pass/host/db)
# Note: Special characters in password must be URL-encoded (e.g., @ = %40)
DATABASE_URL="mysql://root:password@localhost:3306/homebiz"

# JWT Configuration
JWT_SECRET="your-super-secret-key-min-32-characters-long"
JWT_EXPIRES_IN="7d"

# SMTP Configuration (Email notifications)
SMTP_ENABLED="true"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@homebiz.local"

# WhatsApp Configuration (whatsapp-web.js browser automation)
# Note: whatsapp-web.js requires Chromium/Chrome browser installed on the system
# On first run, scan the QR code at GET /webhooks/whatsapp/qr to link your WhatsApp account
# Sessions are stored in .wbot_sessions/ directory
WHATSAPP_ENABLED="true"
